          "renameFallbackOutput": "Blocked"
        }
      }
    },
    {
      "id": "de38c782-d327-5af6-8961-dbf45b06388b",
      "name": "Final proposal",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2820,
        0
      ],
      "parameters": {
        "jsCode": "// Only use the frozen proposal that was actually shown for approval.\nif ($json.gate_status !== 'approved' || !$json.approved_by) {\n  throw new Error('No authenticated approval. External writes blocked.');\n}\nconst prepared = $('Build approval message').first().json;\nif (prepared.enableWrites !== true || !prepared.approverIds.includes($json.approved_by)) {\n  throw new Error('Reviewer or write permission changed. External writes blocked.');\n}\nreturn [{json:{...prepared.proposal,approved_by:$json.approved_by,\n  responded_at:$json.responded_at,destination_id:prepared.destinationId}}];\n"
      }
    },
    {
      "id": "8e03a0d0-ec76-5cfd-a8b0-ec7770007af8",
      "name": "Which write?",
