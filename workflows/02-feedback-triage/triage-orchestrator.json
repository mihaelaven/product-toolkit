    {
      "id": "e287cc72-0bd7-5f06-9308-0d23cfac2660",
      "name": "Proposal format",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1420,
        320
      ],
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"category\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"bug\",\n        \"feature_request\",\n        \"noise\"\n      ]\n    },\n    \"summary\": {\n      \"type\": \"string\",\n      \"description\": \"One sentence\"\n    },\n    \"action\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"comment_on_issue\",\n        \"create_issue\",\n        \"log_request\",\n        \"none\"\n      ]\n    },\n    \"linear_issue_identifier\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"linear_issue_id\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"title\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ],\n      \"description\": \"New issue title or request title\"\n    },\n    \"body\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ],\n      \"description\": \"Issue description, comment, or request quote\"\n    },\n    \"priority\": {\n      \"type\": [\n        \"integer\",\n        \"null\"\n      ]\n    },\n    \"client\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"evidence\": {\n      \"type\": \"string\",\n      \"description\": \"What the specialist found: matched issue, similar requests, demand\"\n    },\n    \"confidence\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"high\",\n        \"medium\",\n        \"low\"\n      ]\n    }\n  },\n  \"required\": [\n    \"category\",\n    \"summary\",\n    \"action\",\n    \"evidence\",\n    \"confidence\"\n  ]\n}"
      }
    },
    {
