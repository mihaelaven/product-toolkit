    {
      "id": "643cf43a-a461-52a3-b368-3773357479cf",
      "name": "Build approval message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1720,
        120
      ],
      "parameters": {
        "jsCode": "// Freeze the exact proposal shown to the reviewer. Never publish a resume URL.\nconst cfg = $('Config').first().json;\nconst p = $json.output;\nconst ids = String(cfg.approver_user_ids || '').split(',').map(s => s.trim()).filter(Boolean);\nif (!ids.length || ids.some(id => !/^[UW][A-Z0-9]{8,}$/.test(id))) {\n  throw new Error('Configure a nonempty list of Slack approver user IDs before running.');\n}\nif (!/^[CGD][A-Z0-9]{8,}$/.test(String(cfg.review_channel_id || ''))) {\n  throw new Error('Configure the review channel ID before running.');\n}\nif (!p || !['create_issue', 'comment_on_issue', 'log_request'].includes(p.action)) {\n  throw new Error('Invalid proposal action.');\n}\nif (typeof p.title !== 'string' || !p.title.trim() || p.title.length > 200 ||\n    typeof p.body !== 'string' || !p.body.trim() || p.body.length > 2000) {\n  throw new Error('Proposal needs a complete title (up to 200 characters) and body (up to 2000). Resubmit a shorter proposal.');\n}\nif (p.action === 'comment_on_issue' && !/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(String(p.linear_issue_id || ''))) {\n  throw new Error('A duplicate comment needs a valid Linear issue ID.');\n}\nif (p.priority != null && (!Number.isInteger(p.priority) || p.priority < 0 || p.priority > 4)) {\n  throw new Error('Invalid issue priority.');\n}\nconst target = p.action === 'log_request' ? cfg.feedback_db_id : cfg.linear_team_id;\nif (typeof target !== 'string' || !/^[0-9a-f-]{32,36}$/i.test(target)) {\n  throw new Error('Configure the destination database or team ID before requesting approval.');\n}\nconst proposal = {action:p.action,title:p.title,body:p.body,priority:p.priority ?? 0,\n  linear_issue_id:p.linear_issue_id ?? null,linear_issue_identifier:p.linear_issue_identifier ?? null,\n  client:p.client ?? null,source_text:$('Normalize message').first().json.text};\nconst issuedAt = new Date().toISOString();\n// Escape Slack markup in user/model content so it cannot forge links or mentions.\nconst esc = v => String(v ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');\nconst message = ['Feedback triage proposal', 'Action: '+proposal.action,\n  'Title: '+proposal.title, 'Destination ID: '+target,\n  proposal.linear_issue_id ? 'Existing issue ID: '+proposal.linear_issue_id : '',\n  'Client: '+(proposal.client || 'unspecified'), 'Priority: '+proposal.priority,\n  'Body:', proposal.body,\n  'Approve the exact proposal above, or reject it and resubmit corrected feedback.',\n  cfg.enable_writes === true ? 'Writes enabled for this run.' : 'DRY RUN: external business writes disabled.']\n  .filter(Boolean).map(esc).join('\\n');\nif (message.length > 2800) throw new Error('Escaped review message is too long. Resubmit a shorter proposal.');\nreturn [{json:{proposal,issuedAt,message,approverIds:ids,\n  reviewChannel:cfg.review_channel_id,destinationId:target,enableWrites:cfg.enable_writes === true}}];\n"
      }
    },
    {
      "id": "4794e81a-26ff-5958-b0fe-a142e939e643",
      "name": "Wait for authenticated Slack approval",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.7,
      "position": [
        1940,
        120
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendAndWait",
        "authentication": "accessToken",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "={{ $('Build approval message').first().json.reviewChannel }}",
          "mode": "id"
        },
        "message": "={{ $json.message }}",
        "responseType": "approval",
        "captureResponder": true,
        "approvers": "={{ $('Build approval message').first().json.approverIds }}",
        "approvalOptions": {
          "values": {
            "approvalType": "double",
            "approveLabel": "Approve",
            "disapproveLabel": "Reject"
          }
        },
        "postDecisionBehavior": "showOutcome",
        "unauthorizedReplyText": "Only the configured reviewers can approve this proposal.",
        "options": {
          "appendAttribution": false,
          "limitWaitTime": {
            "values": {
              "limitType": "afterTimeInterval",
              "resumeAmount": 2,
              "resumeUnit": "days"
            }
          }
        }
      },
      "credentials": {
        "slackApi": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL",
          "name": "Slack bot token"
        }
      },
      "webhookId": "e6275569-88e9-4cb4-87b7-3f07838c6f06"
    },
    {
      "id": "01821e3c-48db-586f-a1ef-8bc9a0f0763f",
      "name": "Decision",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        2380,
        120
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "f7c96519-5dc4-53fa-8046-3b6c1ac76113",
