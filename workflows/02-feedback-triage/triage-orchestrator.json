    {
      "id": "81518612-f0ae-5250-a1d9-e3ff20738729",
      "name": "Note: classified as noise",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.7,
      "position": [
        1720,
        -80
      ],
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "={{ $('Config').first().json.review_channel_id }}",
          "mode": "id"
        },
        "text": "=Triage: classified as noise, no action. \"{{ $('Normalize message').first().json.text.slice(0, 200) }}\"\nReason: {{ $json.output.summary }}",
        "otherOptions": {
          "includeLinkToWorkflow": false
        }
      },
