    {
      "id": "82be3d62-8e73-5dea-963d-0a6eb898c547",
      "name": "Design note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        400,
        -340
      ],
      "parameters": {
        "width": 900,
        "height": 260,
        "color": 7,
        "content": "## Authenticated approvals\nNative Slack send-and-wait with responder capture, a required approver list, and signed Slack callbacks. Validate approval checks identity, channel and expiry. Missing data blocks writes. No custom resume URLs or free-text edit route. Correct a proposal by rejecting and resubmitting. Business writes default off."
      }
    },
    {
      "id": "0b570994-0efc-4bcd-8fc0-aec607c76864",
      "name": "Validate approval",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2160,
        120
      ],
      "parameters": {
        "jsCode": "// Slack signature verification is performed by the native Slack approval node.\n// This check independently binds the response to the configured reviewer, channel and window.\nconst prepared = $('Build approval message').first().json;\nconst data = $json.data;\nconst now = Date.now();\nconst issued = Date.parse(prepared.issuedAt);\nconst responded = Date.parse(data?.respondedAt);\nconst maxAge = 2 * 24 * 60 * 60 * 1000;\nlet status = 'invalid';\nif (!data || typeof data.approved !== 'boolean') status = 'timeout_or_invalid';\nelse if (!Array.isArray(prepared.approverIds) || prepared.approverIds.length === 0 ||\n  data.responder?.source !== 'slack' || !prepared.approverIds.includes(data.responder?.id) ||\n  data.channel !== prepared.reviewChannel || typeof data.messageId !== 'string' || !/^\\d+\\.\\d+$/.test(data.messageId)) status = 'unauthorized';\nelse if (!Number.isFinite(issued) || !Number.isFinite(responded) ||\n  now < issued || now - issued > maxAge || responded < issued ||\n  responded > now + 5 * 60 * 1000 || responded - issued > maxAge) status = 'expired';\nelse if (data.approved === false) status = 'rejected';\nelse status = prepared.enableWrites === true ? 'approved' : 'dry_run';\nreturn [{json:{gate_status:status,approved_by:status === 'approved' ? data.responder.id : null,\n  responded_at:Number.isFinite(responded) ? data.respondedAt : null}}];\n"
      }
    },
