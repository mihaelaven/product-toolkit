    {
      "id": "21d5bef4-431b-5484-9559-b1d1c5b3d88c",
      "name": "Orchestrator agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1120,
        80
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Slack message from user {{ $json.user }}:\n{{ $json.text }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are the triage orchestrator for Fernpay product feedback (fictional company).\nClassify one Slack message, call the right specialist, and return a single proposal for a human to approve.\n\nCategories:\n- bug: something that used to work, or should work, is broken. Call bug_specialist.\n- feature_request: a client or colleague asks for something new or changed. Call request_specialist.\n- noise: thanks, chatter, questions with no product ask, duplicates of a message you already handled. Call no tool.\n\nRules:\n- Call at most one specialist, once. Pass the message text unchanged.\n- Base the proposal only on the specialist's result. Do not invent issue ids, clients or numbers.\n- action is: comment_on_issue (bug duplicate), create_issue (new bug), log_request (feature request), none (noise).\n- Nothing is written anywhere until a human approves your proposal.",
          "maxIterations": 6
        }
      }
    },
