              "renameOutput": true,
              "outputKey": "Create issue"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "49b78ee6-7db0-5eeb-86c6-d30cf33712cd",
                    "leftValue": "={{ $json.action }}",
